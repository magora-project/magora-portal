#!/bin/sh
# Warning-only hook (never blocks). Installed by: npm run setup:hooks
if command -v node >/dev/null 2>&1; then
  node scripts/hooks/pre-push.mjs "$@" || echo "review-evidence warning hook failed (node exit $?); not blocking" >&2
else
  echo "node not found; review-evidence warning skipped" >&2
fi
exit 0
