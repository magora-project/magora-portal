{
  "rewrites": [
    { "source": "/node/:id/report/:date", "destination": "/api/report-page?id=:id&date=:date" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/insight-batch", "schedule": "0 8 * * *" },
    { "path": "/api/node-status-check", "schedule": "0 9 * * *" },
    { "path": "/api/range-allowlist-build", "schedule": "0 6 1 * *" },
    { "path": "/api/report-cron?cadence=daily", "schedule": "0 10 * * *" },
    { "path": "/api/report-cron?cadence=seasonal", "schedule": "0 11 1 3,6,9,12 *" },
    { "path": "/api/report-cron?cadence=annual", "schedule": "0 12 1 1 *" }
  ]
}
